<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://textures.minecraft.net; media-src 'self'; connect-src https://pub-16d8232ded904a1bbed89826fb24c57e.r2.dev https://api.mojang.com https://sessionserver.mojang.com https://textures.minecraft.net https://launchermeta.mojang.com https://piston-meta.mojang.com https://piston-data.mojang.com https://github.com https://api.github.com; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"/>
    <title><%= lang('app.title') %></title>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/aurora-theme.css">
    <style>
        html,
        body {
            width: 100%;
            height: 100%;
            min-height: 100%;
        }
        body {
            transition: background-image 0.6s ease;
            background-image: url('assets/images/backgrounds/0.webp');
            background-position: center 44%;
            background-repeat: no-repeat;
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            top: 38px;
            height: calc(100% - 38px);
            background: linear-gradient(180deg, rgba(2, 5, 20, 0.06) 0%, rgba(2, 5, 20, 0.15) 58%, rgba(2, 5, 20, 0.38) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <div id="loadSpinnerRing"></div>
                <img id="loadCenterImage" src="assets/images/SealCircle.png">
            </div>
            <div id="loadingBrand">POKEAURORA</div>
            <div id="slogan"><%= lang('landing.heroEyebrow') %></div>
        </div>
    </div>
</body>
</html>
